# Copie este archivo a .env.local para desarrollo.
# En GitHub: Settings → Secrets and variables → Actions
#   PUBLIC_SUPABASE_URL
#   PUBLIC_SUPABASE_ANON_KEY
#
# Next.js también acepta el prefijo NEXT_PUBLIC_ (necesario para el bundle estático).

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PIN de coordinación. En producción se guarda en Supabase
# (tabla configuracion, clave org_pin) al ejecutar supabase/schema.sql.
# Esta variable solo se usa en el modo local (sin Supabase).
ORG_PIN=sjb36
